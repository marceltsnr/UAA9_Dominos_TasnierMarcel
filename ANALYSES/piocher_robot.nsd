<root xmlns:nsd="http://structorizer.fisch.lu/" version="3.24" text="&#34;piocher robot&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<alternative text="&#34;(nbDominosTalon == 0)&#34;" comment="&#34;&#34;" color="ffffff">
			<qTrue>
				<instruction text="&#34;false&#34;" comment="&#34;&#34;" color="ffffff" rotated="0"></instruction>
			</qTrue>
			<qFalse>
			</qFalse>
		</alternative>
		<for text="&#34; for (int i = 0; i &#60; nbDominosTalon - 1; i++)&#34;" comment="&#34;&#34;" counterVar="dummy_counter" startValue="for (int i == 0; i &#60; nbDominosTalon - 1; i++)" stepConst="1" reliable="false" color="ffffff">
			<qFor>
				<instruction text="&#34;talonRestant[i] = talonRestant[i + 1]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0"></instruction>
